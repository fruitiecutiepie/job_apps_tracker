{
  "name": "job-applications-tracker",
  "description": "A job search organizer that keeps every application in a JSON file on your own machine — no account, no backend, no sync.",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:demo": "VITE_TRACKER_PROFILE=demo vite --port 5273",
    "start": "vite preview",
    "start:demo": "VITE_TRACKER_PROFILE=demo vite preview --port 4273",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:smoke": "vitest run src/test/smoke.test.tsx",
    "test:browser": "vitest run -c vitest.browser.config.ts",
    "test:watch": "vitest",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build",
    "verify:all": "pnpm run verify && pnpm run test:browser"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@testing-library/user-event": "latest",
    "@types/node": "^26.2.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "jsdom": "latest",
    "playwright": "latest",
    "typescript": "^5.9.3",
    "typescript-eslint": "latest",
    "vite": "latest",
    "vitest": "latest"
  },
  "packageManager": "pnpm@10.30.3"
}
