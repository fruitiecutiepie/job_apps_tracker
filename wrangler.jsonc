{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "job-apps-tracker",
  "compatibility_date": "2026-10-07",
  // The hourly push goes to api.fruitiecutiepie.com, another Worker on this zone: sent the way
  // any outside client would send it, so it reaches that Worker rather than the zone's origin.
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": false,
  // Runs only for usage reports: every other path is a static file the asset handler serves.
  "main": "./worker/index.ts",
  "observability": {
    "enabled": true,
    // A tracker's id is in its URL, and a request log holds the address it came from. Neither
    // is kept: the query string is dropped and the per-request log is off.
    "redact_query_string": true,
    "logs": {
      "invocation_logs": false
    },
    "traces": {
      "enabled": false
    }
  },
  "routes": [
    {
      "pattern": "fruitiecutiepie.com/projects/job_apps_tracker/app*",
      "zone_name": "fruitiecutiepie.com"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // /app and /app/ both open the app. /app is the address that stays.
    "html_handling": "drop-trailing-slash",
    "run_worker_first": ["/projects/job_apps_tracker/app/__usage"]
  },
  // Usage counts; see src/usageEvent.ts for every value a row can hold. Analytics Engine keeps
  // rows for three months and then drops them.
  "analytics_engine_datasets": [
    {
      "binding": "USAGE",
      "dataset": "job_apps_tracker_usage"
    }
  ],
  // Hourly, the usage summary goes to the project's progress page (worker/index.ts, `scheduled`).
  "triggers": {
    "crons": ["7 * * * *"]
  },
  "vars": {
    "USAGE_PUSH_URL": "https://api.fruitiecutiepie.com/projects/job-apps-tracker/usage"
  }
  // Secrets for the push, set with `wrangler secret put`:
  //   ANALYTICS_ACCOUNT_ID  the Cloudflare account the dataset is in
  //   ANALYTICS_TOKEN       an API token with Account → Account Analytics → Read
  //   USAGE_PUSH_TOKEN      this project's token from fruitiecutiepie.com (its scripts/usage-token)
}
