{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "job-apps-tracker",
  "compatibility_date": "2026-10-07",
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "routes": [
    {
      "pattern": "fruitiecutiepie.com/projects/job_apps_tracker/app*",
      "zone_name": "fruitiecutiepie.com"
    }
  ],
  "assets": {
    "directory": "./dist",
    // /app and /app/ both open the app. /app is the address that stays.
    "html_handling": "drop-trailing-slash"
  }
}
