#!/usr/bin/env bash
# Runs OpenTofu in infra/cloudflare with the Cloudflare API token and the state
# passphrase from Bitwarden.
# Usage: scripts/tofu plan
set -euo pipefail
cd "$(dirname "$0")/.."
source scripts/lib/bw.sh

bw_require_unlocked
token="$(bw_secret CLOUDFLARE_API_TOKEN)"
passphrase="$(bw_secret TOFU_STATE_PASSPHRASE)"
CLOUDFLARE_API_TOKEN="$token" TF_VAR_state_passphrase="$passphrase" \
  exec tofu -chdir=infra/cloudflare "$@"
