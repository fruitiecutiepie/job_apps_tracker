#!/usr/bin/env bash
# Gives .github/workflows/deploy.yml its Cloudflare token: copies it from
# Bitwarden into the repository's `production` environment, creating that
# environment, limited to master, if it does not exist yet.
#
# Usage: scripts/push-github-secrets
#
# Needs `gh auth login` with admin on the repository.
set -euo pipefail
cd "$(dirname "$0")/.."
source scripts/lib/bw.sh

repo="$(gh repo view --json nameWithOwner -q .nameWithOwner)"
env=production

# Only master may deploy: a workflow on any other branch is refused the
# environment, and with it the token.
gh api -X PUT "repos/$repo/environments/$env" --silent \
  -F 'deployment_branch_policy[protected_branches]=false' \
  -F 'deployment_branch_policy[custom_branch_policies]=true'
if ! gh api "repos/$repo/environments/$env/deployment-branch-policies" \
  -q '.branch_policies[].name' | grep -qx master; then
  gh api -X POST "repos/$repo/environments/$env/deployment-branch-policies" --silent \
    -f name=master -f type=branch
fi

bw_require_unlocked
bw_secret CLOUDFLARE_DEPLOY_API_TOKEN |
  gh secret set CLOUDFLARE_API_TOKEN --repo "$repo" --env "$env"
echo "Set CLOUDFLARE_API_TOKEN on $repo ($env)"
