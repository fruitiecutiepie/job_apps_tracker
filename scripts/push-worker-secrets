#!/usr/bin/env bash
# Uploads the Worker's secrets from Bitwarden to Cloudflare. This changes
# production immediately: wrangler makes a new live version carrying the
# secrets, with no build or review.
#
# Usage: scripts/push-worker-secrets
#
# Runs on your own wrangler login (`pnpm wrangler login`), not the deploy
# token GitHub holds, which can only deploy.
set -euo pipefail
cd "$(dirname "$0")/.."
source scripts/lib/bw.sh

bw_require_unlocked
feedback_admin="$(bw_secret FEEDBACK_ADMIN_TOKEN)"
analytics="$(bw_secret ANALYTICS_TOKEN)"
usage_push="$(bw_secret USAGE_PUSH_TOKEN)"
jq -n --arg feedback_admin "$feedback_admin" --arg analytics "$analytics" --arg usage_push "$usage_push" \
  '{FEEDBACK_ADMIN_TOKEN: $feedback_admin, ANALYTICS_TOKEN: $analytics, USAGE_PUSH_TOKEN: $usage_push}' |
  pnpm exec wrangler secret bulk
